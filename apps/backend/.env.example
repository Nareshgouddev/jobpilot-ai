# Runtime
NODE_ENV=development
PORT=4000

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_TIMEOUT_MS=20000
OPENROUTER_MAX_RETRIES=2

# JWT
JWT_SECRET=replace-with-a-random-secret-at-least-24-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=jobpilot-backend
JWT_AUDIENCE=jobpilot-extension

# Extension auth
EXTENSION_SHARED_SECRET=replace-with-a-random-secret-at-least-24-characters

# Admin
ADMIN_API_KEY=

# Observability
# Optional: leave empty or remove if not using Sentry
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Security
CORS_ORIGIN=chrome-extension://your-extension-id

# Logging
LOG_LEVEL=info
