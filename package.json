{
  "name": "jobpilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "JobPilot AI monorepo (Chrome extension + backend + shared packages)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "npm run -ws build",
    "dev": "npm run -ws dev --if-present",
    "test": "npm run -ws test --if-present",
    "lint": "npm run -ws lint --if-present",
    "typecheck": "npm run -ws typecheck --if-present"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
